[core]
	editor = nano
	fileMode = false
[alias]
  bclean = "!f() { $DOTFILES/scripts/git/bclean.sh \"${@}\";}; f"
[pull]
	rebase = false
[push]
	default = current
	autoSetupRemote = true
[diff]
    tool = meld
[difftool]
    prompt = false
[difftool "meld"]
    cmd = meld "$LOCAL" "$REMOTE"
[credential]
	helper = cache

# Identity and machine-specific settings, not tracked in git. Included last,
# so it overrides anything above. Template: config/.gitconfig.local.example
[include]
	path = ~/.gitconfig.local
