[core]
	editor = nano
	fileMode = false
[alias]
  next = "!f() { $DOTFILES/scripts/git/gitnext.sh \"${@}\";}; f"
  bclean = "!f() { $DOTFILES/scripts/git/bclean.sh \"${@}\";}; f"
[pull]
	rebase = false
[push]
	default = current
	autoSetupRemote = true
[diff]
    tool = meld
[difftool]
    prompt = false
[difftool "meld"]
    cmd = meld "$LOCAL" "$REMOTE"
[credential]
	helper = cache
[user]
	email = guilherme.lousadaramos@dentsplysirona.com
	name = Guilherme Lousada Ramos
[credential "https://bitbucket.dentsplysirona.com"]
	username = guilherme.lousadaramos@dentsplysirona.com
